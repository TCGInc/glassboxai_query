# Local secrets
.env
.env.*
!.env.example

# LibreChat configuration, generated from agent/ by agent/librechat_config.py
librechat/*
!librechat/.gitkeep

# Generated FDA snapshots (recreate with scripts/convert_fda_workbooks.py)
data/*.csv

# Python bytecode and local test/lint caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Eval reports (contain full agent transcripts)
tests/reports/

# Jupyter autosave checkpoints
.ipynb_checkpoints/
