# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- LLM (used by both runtimes) ---
LLM_MODEL_ID=gpt-6-luna
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database ---
# Admin password: used only by the Postgres init scripts.
POSTGRES_PASSWORD=change-me
# Password for the read-only role the agents connect as.
AGENT_RO_PASSWORD=change-me-too
# POSTGRES_DB=fda
# POSTGRES_USER=fda_admin
# AGENT_RO_USER=agent_ro

# --- Services ---
JUPYTER_TOKEN=change-me-as-well
WEBUI_SECRET_KEY=change-me-also

# --- Evals ---
# Runs per question in `pytest -m agent`, and the fraction of runs that must be
# correct for a question to pass
# EVAL_RUNS=5
# EVAL_MIN_CORRECT=0.8
# Optional filters: comma-separated question ids or tiers
# EVAL_QUESTIONS=q001,q014
# EVAL_TIERS=ambiguous,unanswerable
