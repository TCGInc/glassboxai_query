# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- LLM (used by both runtimes) ---
LLM_MODEL_ID=gpt-6-luna
# "none" turns off hidden reasoning so the model reasons in visible text. Leave empty for
# the provider default. After changing either, rerun ./start.sh (it rewrites LibreChat's config).
# For LibreChat, LLM_MODEL_ID must be in OPENAI_MODELS in docker-compose.yml.
# LLM_REASONING_EFFORT=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database ---
# Admin password: used only by the Postgres init scripts.
POSTGRES_PASSWORD=change-me
# Password for the read-only role the agents connect as.
AGENT_RO_PASSWORD=change-me-too
# POSTGRES_DB=fda
# POSTGRES_USER=fda_admin
# AGENT_RO_USER=agent_ro

# --- Services ---
JUPYTER_TOKEN=change-me-as-well
# LibreChat admin login, created by start.sh. The defaults (admin@tcg.com / glassbox) are
# demo-grade: fine on localhost, but set your own before sharing the stack. The password needs
# at least 8 characters. After changing them, run ./stop.sh --reset so the account is recreated.
# ADMIN_EMAIL=admin@tcg.com
# ADMIN_PASSWORD=glassbox
# LibreChat's encryption and session secrets (LIBRECHAT_CREDS_KEY, LIBRECHAT_CREDS_IV,
# LIBRECHAT_JWT_SECRET, LIBRECHAT_JWT_REFRESH_SECRET) are generated and appended by start.sh.

# --- Evals ---
# Runs per question in `pytest -m agent`, and the fraction of runs that must be
# correct for a question to pass
# EVAL_RUNS=5
# EVAL_MIN_CORRECT=0.8
# Optional filters: comma-separated question ids or tiers
# EVAL_QUESTIONS=q001,q014
# EVAL_TIERS=ambiguous,unanswerable
