# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- LLM (used by both runtimes) ---
LLM_MODEL_ID=gpt-6-luna
# "none" turns off hidden reasoning so the model reasons in visible text. Leave empty for
# the provider default. Re-run the Open WebUI provisioner after changing it.
# LLM_REASONING_EFFORT=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database ---
# Admin password: used only by the Postgres init scripts.
POSTGRES_PASSWORD=change-me
# Password for the read-only role the agents connect as.
AGENT_RO_PASSWORD=change-me-too
# POSTGRES_DB=fda
# POSTGRES_USER=fda_admin
# AGENT_RO_USER=agent_ro

# --- Services ---
JUPYTER_TOKEN=change-me-as-well
WEBUI_SECRET_KEY=change-me-also
# Open WebUI admin login, created on first start. The defaults (admin@tcg.com / demo) are demo-grade:
# fine on localhost, but set your own before sharing the stack. After changing them, run
# ./stop.sh --reset and clear openwebui/data so the account is recreated.
# WEBUI_ADMIN_EMAIL=admin@tcg.com
# WEBUI_ADMIN_PASSWORD=demo

# --- Evals ---
# Runs per question in `pytest -m agent`, and the fraction of runs that must be
# correct for a question to pass
# EVAL_RUNS=5
# EVAL_MIN_CORRECT=0.8
# Optional filters: comma-separated question ids or tiers
# EVAL_QUESTIONS=q001,q014
# EVAL_TIERS=ambiguous,unanswerable
